lh_silver = "{{ c.lakehouse_silver }}"
lh_gold = "{{ c.lakehouse_gold }}"
lh_control = "{{ c.lakehouse_control }}"
entidad = "{{ e.entidad }}"
esquema_destino = "{{ e.destino.esquema }}"
tabla_destino = "{{ e.destino.tabla }}"
borrar_ausentes = {{ "True" if e.borrar_ausentes else "False" }}
evolucion_esquema = True   # añadir a Gold las columnas nuevas de la consulta
simular = False            # True: ejecuta la consulta, valida y registra en el log, pero no escribe en Gold
