#
# - **Destino:** `{{ c.lakehouse_gold }}.{{ e.destino.esquema }}.{{ e.destino.tabla }}`. **Grano y clave del MERGE:** `{{ e.clave | join(", ") }}`.
# - **Lee:** {% for d in e.dependencias_tablas %}`{{ d.capa }}.{{ d.esquema }}.{{ d.tabla }}`{% if not loop.last %}, {% endif %}{% endfor %}.
# - Inserta, actualiza (solo si cambia la fila) {% if e.borrar_ausentes %}y borra lo que ya no devuelve la consulta{% else %}y no borra nada{% endif %}. Sin SCD2.

# %% [parameters]
proyecto = "{{ c.proyecto }}"
